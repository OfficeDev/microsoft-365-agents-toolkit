{
  "$schema": "../../schema/descriptor.schema.json",
  "id": "default-bot",
  "name": "Teams Simple Bot",
  "languages": ["typescript", "javascript", "python"],
  "languageOptions": [
    { "id": "python", "description": "core.createProjectQuestion.option.description.preview" }
  ],
  "minEngineVersion": "6.12.0",
  "spec": "docs/03-specs/scenarios/teams/create-default-bot.md",
  "requiresNetwork": false,

  "optionsSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },

  "replaceMap": [
    { "var": "NewDeveloperPortalApis", "when": "featureFlag('TEAMSFX_NEW_DP_APIS')", "value": "true" },
    { "var": "SafeProjectNameLowerCase", "expr": "safeProjectNameLowerCase(appName)" },
    { "var": "SandBoxedTeam", "when": "featureFlag('TEAMSFX_SANDBOXED_TEAM')", "value": "true" },
    { "var": "pathDelimiter", "expr": "pathDelimiter()" }
  ]
}
