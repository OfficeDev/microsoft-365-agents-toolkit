{
  "component": {
    "version": 1,
    "id": "editorFile",
    "parameters": ["instanceSuffix", "filePath", "resultAssertion", "completionKey", "completionDescription", "readyAssertion"]
  },
  "steps": [
    {
      "step_id": "step_editorFile_openPicker_{{text:instanceSuffix}}",
      "agent": "interaction",
      "tool": "keyboard_shortcut",
      "parameters": {"keys": "ctrl+p"},
      "description": "Open VS Code Quick Open to verify a project file by its absolute path.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": [],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor"]
    },
    {
      "step_id": "step_editorFile_assertPicker_{{text:instanceSuffix}}",
      "agent": "assertion",
      "tool": "",
      "parameters": {},
      "description": "@assertion VS Code Quick Open is visible with its file-search input focused, not the Command Palette command input.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFile_openPicker_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor", "step_retry_timeout: 30"]
    },
    {
      "step_id": "step_editorFile_selectQuery_{{text:instanceSuffix}}",
      "agent": "interaction",
      "tool": "keyboard_shortcut",
      "parameters": {"keys": "ctrl+a"},
      "description": "Select the previous Quick Open query so the absolute file path replaces it.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFile_assertPicker_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor"]
    },
    {
      "step_id": "step_editorFile_typePath_{{text:instanceSuffix}}",
      "agent": "interaction",
      "tool": "type_text",
      "parameters": {"text": "/home/vscode/AgentsToolkitProjects/${{var:app_name}}/{{text:filePath}}"},
      "description": "Type the exact generated-project path for {{text:filePath}} into Quick Open.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFile_selectQuery_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor"]
    },
    {
      "step_id": "step_editorFile_assertResult_{{text:instanceSuffix}}",
      "agent": "assertion",
      "tool": "",
      "parameters": {},
      "description": {{json:resultAssertion}},
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFile_typePath_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "assertion:file", "verification:editor", "step_retry_timeout: 120"]
    },
    {
      "step_id": "step_editorFile_complete_{{text:instanceSuffix}}",
      "agent": "interaction",
      "tool": "key_press",
      "parameters": {"key": {{json:completionKey}}},
      "description": {{json:completionDescription}},
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFile_assertResult_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor"]
    },
    {
      "step_id": "step_editorFile_assertReady_{{text:instanceSuffix}}",
      "agent": "assertion",
      "tool": "",
      "parameters": {},
      "description": {{json:readyAssertion}},
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFile_complete_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor", "step_retry_timeout: 30"]
    }
  ]
}
