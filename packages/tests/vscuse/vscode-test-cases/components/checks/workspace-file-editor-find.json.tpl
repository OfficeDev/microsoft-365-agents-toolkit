{
  "component": {
    "version": 1,
    "id": "editorFileFind",
    "parameters": ["instanceSuffix", "searchText", "resultAssertion"]
  },
  "steps": [
    {
      "step_id": "step_editorFileFind_open_{{text:instanceSuffix}}",
      "agent": "interaction",
      "tool": "keyboard_shortcut",
      "parameters": {"keys": "ctrl+f"},
      "description": "Open Find in the active project file.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": [],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor"]
    },
    {
      "step_id": "step_editorFileFind_assertDefaults_{{text:instanceSuffix}}",
      "agent": "assertion",
      "tool": "",
      "parameters": {},
      "description": "@assertion the editor Find input is focused, Match Case is disabled, Use Regular Expression is disabled, Match Whole Word is disabled, and Find in Selection is disabled.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFileFind_open_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor", "step_retry_timeout: 30"]
    },
    {
      "step_id": "step_editorFileFind_enableCase_{{text:instanceSuffix}}",
      "agent": "interaction",
      "tool": "keyboard_shortcut",
      "parameters": {"keys": "alt+c"},
      "description": "Enable Match Case for literal, case-sensitive file-content verification.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFileFind_assertDefaults_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor"]
