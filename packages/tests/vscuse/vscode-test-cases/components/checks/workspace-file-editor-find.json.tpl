      "step_id": "step_editorFileFind_assertRestored_{{text:instanceSuffix}}",
      "agent": "assertion",
      "tool": "",
      "parameters": {},
      "description": "@assertion the editor Find widget has Match Case, Use Regular Expression, Match Whole Word, and Find in Selection disabled.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFileFind_restoreCase_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor", "step_retry_timeout: 30"]
