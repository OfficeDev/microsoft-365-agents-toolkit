      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFileFind_enableCase_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor"]
    },
    {
      "step_id": "step_editorFileFind_type_{{text:instanceSuffix}}",
      "agent": "interaction",
      "tool": "type_text",
