      "description": "Type the authored literal file-content expectation into Find.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFileFind_selectQuery_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor"]
    },
    {
      "step_id": "step_editorFileFind_assertResult_{{text:instanceSuffix}}",
      "agent": "assertion",
      "tool": "",
      "parameters": {},
      "description": {{json:resultAssertion}},
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFileFind_type_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "assertion:file-content", "verification:editor", "step_retry_timeout: 120"]
    },
    {
      "step_id": "step_editorFileFind_restoreCase_{{text:instanceSuffix}}",
      "agent": "interaction",
      "tool": "keyboard_shortcut",
      "parameters": {"keys": "alt+c"},
      "description": "Restore Match Case to disabled after the verified search.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFileFind_assertResult_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
