      "step_id": "step_editorFileFind_close_{{text:instanceSuffix}}",
      "agent": "interaction",
      "tool": "key_press",
      "parameters": {"key": "escape"},
      "description": "Close the verified editor Find widget.",
      "content_refs": [],
      "timeout": 30,
      "retry_count": 0,
      "continue_on_error": "false",
      "depends_on": ["step_editorFileFind_assertRestored_{{text:instanceSuffix}}"],
      "preconditions": [],
      "postconditions": [],
      "tags": ["component:checks", "verification:editor"]
    }
  ]
